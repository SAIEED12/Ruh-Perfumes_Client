# Copy to .env.local (or set these in your hosting panel) before running.

# MongoDB Atlas — same database as the Express API.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=ruh_perfumes

# This site's public URL (no trailing slash). Leave empty in local dev.
BETTER_AUTH_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Express API base URL, e.g. http://localhost:5000
SERVER_URL=

# Public storefront URL used in metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional Meta Pixel credentials.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
